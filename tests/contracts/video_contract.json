{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SPECULUM Video Contract",
    "description": "Contract for final video output from F07 PORTE-AVIONS",
    "codec": {
        "video": ["h264", "hevc"],
        "audio": ["aac"]
    },
    "container": ["mp4", "mov"],
    "resolution": {
        "min": [960, 540],
        "max": [3840, 2160]
    },
    "fps": {
        "min": 12,
        "max": 60,
        "common": [24, 30, 60]
    },
    "bitrate_mbps": {
        "min": 5,
        "max": 100,
        "recommended": {
            "540p": 8,
            "1080p": 20,
            "4k": 50
        }
    },
    "audio": {
        "required": true,
        "codec": "aac",
        "sample_rate": 44100,
        "channels": 2,
        "bitrate_kbps": 192
    },
    "duration": {
        "min_seconds": 10,
        "max_seconds": 600
    },
    "quality_metrics": {
        "ssim_min": 0.85,
        "psnr_min_db": 30
    },
    "platform_profiles": {
        "youtube": {
            "resolution": [1920, 1080],
            "fps": 30,
            "bitrate_mbps": 20
        },
        "instagram": {
            "resolution": [1080, 1920],
            "fps": 30,
            "bitrate_mbps": 15
        },
        "tiktok": {
            "resolution": [1080, 1920],
            "fps": 30,
            "bitrate_mbps": 12
        }
    }
}
